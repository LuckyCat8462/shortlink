syntax = "v1"

//转链
type ConvertRequest {
	LongURL string `json:"longUrl" validate:"required"`
}

type ConvertResponse {
	ShortURL string `json:"shortUrl"`
}

//查链接
type ShowUrlRequest {
	ShortURL string `path:"shortUrl" validate:"required"`
}

type ShowUrlResponse {
	LongURL string `json:"longUrl"`
}

service shorturl-api {
	// 发长链，映射短链接
	//post /convert,静态路由，不携带动态参数，适用于资源明确、不需要通过URL路径区分
	@handler ShorturlHandler
	post /convert (ConvertRequest) returns (ConvertResponse)

	// 通过短链查长链
	// post /:shortUrl，动态路由，带路径参数，冒号后面的shortUrl是一个占位符，可以匹配实际的url
	@handler ShowUrlHandler
	get /:shortUrl (ShowUrlRequest) returns (ShowUrlResponse)
}

