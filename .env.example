# Local / demo defaults. Copy to .env and edit before compose up:
#   cp .env.example .env
#
# Never commit a real .env with production secrets.

MYSQL_ROOT_PASSWORD=shortlink_dev_pass
MYSQL_DATABASE=shortlink

# Published on host (container still listens on 8888). Default 8890 avoids common 8888 clashes.
API_HOST_PORT=8890

# Used by api (overrides etc/shorturl-api.example.yaml)
SHORTLINK_DSN=root:shortlink_dev_pass@tcp(mysql:3306)/shortlink?parseTime=true&loc=Local&charset=utf8mb4
SHORTLINK_REDIS=redis:6379
SHORTLINK_API_KEY=change-me
SHORTLINK_BASE62_SALT=change-me-in-production
SHORTLINK_DOMAIN=http://127.0.0.1:8890

# Analytics
SHORTLINK_CLICK_LOG=true
SHORTLINK_SEED_DEMO=true

# LLM / assistant (project-specific key; never commit real values)
SHORTLINK_LLM_API_KEY=
SHORTLINK_LLM_BASE_URL=https://api.deepseek.com
SHORTLINK_LLM_MODEL=deepseek-flash
