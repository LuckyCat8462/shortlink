# Example host Nginx reverse proxy for cloud demo (not wired into docker-compose).
# Point public 80/443 here; keep api bound to 127.0.0.1:${API_HOST_PORT} only (default 8890).

upstream shortlink_api {
    server 127.0.0.1:8890;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 1m;

    location / {
        proxy_pass http://shortlink_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

